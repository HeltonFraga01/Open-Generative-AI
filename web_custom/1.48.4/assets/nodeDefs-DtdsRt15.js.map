      "latent": {
        "name": "latent",
        "tooltip": "الكامن المشفر بواسطة VAE الخاص بـ SeedVR2 للتقسيم."
      },
      "temporal_overlap": {
        "name": "temporal_overlap",
        "tooltip": "إطارات الكامن المشتركة بين الأجزاء المتجاورة ويتم دمجها تدريجياً عند الدمج؛ 0 = بدون تداخل."
      }
    },
    "outputs": {
      "0": {
        "name": "latents",
