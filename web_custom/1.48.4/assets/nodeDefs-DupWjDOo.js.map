  "RunwayAleph2VideoToVideoNode": {
    "description": "Редактируйте видео с помощью текстового запроса, используя модель Runway Aleph2. Aleph2 преобразует ваш видеоматериал (смена стиля, освещения, добавление или удаление элементов, изменение точки обзора), сохраняя исходное движение и тайминг; разрешение результата соответствует входному видео, которое должно быть длиной от 2 до 30 секунд с частотой не выше 30 кадров в секунду. Дополнительно можно управлять редактированием с помощью ключевых кадров (привязанных к исходному видео) или изображений-подсказок (привязанных к выходному видео) — используйте только один из этих вариантов, не оба одновременно.",
    "display_name": "Runway Aleph2 Видео в Видео",
    "inputs": {
      "control_after_generate": {
        "name": "control after generate"
      },
      "keyframes": {
        "name": "keyframes",
        "tooltip": "Изображения-направления, привязанные к исходному видео, из узлов Aleph2 Keyframe (до 5). Используйте ключевые кадры или изображения-подсказки, не оба одновременно."
      },
      "prompt": {
        "name": "prompt",
        "tooltip": "Опишите, что должно появиться на выходе (от 1 до 1000 символов)."
      },
      "prompt_images": {
        "name": "prompt_images",
        "tooltip": "Изображения-направления, привязанные к выходному видео, из узлов Aleph2 Prompt Image (до 5). Используйте ключевые кадры или изображения-подсказки, не оба одновременно."
      },
      "public_figure_threshold": {
        "name": "public_figure_threshold",
        "tooltip": "Модерация контента для узнаваемых публичных лиц."
      },
      "seed": {
        "name": "seed",
        "tooltip": "Случайное зерно для генерации"
      },
      "video": {
        "name": "video",
        "tooltip": "Входное видео для редактирования. Должно быть длиной от 2 до 30 секунд с частотой не выше 30 кадров в секунду."
      }
    },
    "outputs": {
      "0": {
        "tooltip": null
      }
    }
  },
  "RunwayFirstLastFrameNode": {
    "description": "Загрузите первый и последний ключевые кадры, составьте промпт и создайте видео. Более сложные переходы, например, когда последний кадр полностью отличается от первого, могут выиграть от более длительной продолжительности в 10 секунд. Это даст генерации больше времени для плавного перехода между двумя входными данными. Прежде чем начать, ознакомьтесь с лучшими практиками, чтобы убедиться, что ваши входные данные обеспечат успешный результат: https://help.runwayml.com/hc/en-us/articles/34170748696595-Creating-with-Keyframes-on-Gen-3.",
