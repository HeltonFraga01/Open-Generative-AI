  "BeebleSwitchXImageEdit": {
    "description": "Редактируйте отдельное изображение с помощью Beeble SwitchX. Меняет любые элементы сцены (фон, освещение, костюм), сохраняя исходные пиксели объекта. Укажите референс-изображение и/или текстовый промпт для описания нового вида. Макс. ~2,77 МП.",
    "display_name": "Beeble SwitchX Редактирование изображения",
    "inputs": {
      "alpha_mode": {
        "name": "alpha_mode",
        "tooltip": "Определяет, как SwitchX решает, что сохранить, а что сгенерировать заново. 'auto' автоматически изолирует основной объект. 'fill' регенерирует весь кадр, сохраняя геометрию. 'select' распространяет ключевой кадр первого кадра по всему clip. 'custom' использует предоставленную вами альфа-маску для каждого кадра."
      },
      "control_after_generate": {
        "name": "контроль после генерации"
      },
      "image": {
        "name": "изображение"
      },
      "max_resolution": {
        "name": "максимальное разрешение",
        "tooltip": "Максимальное разрешение результата."
      },
      "prompt": {
        "name": "промпт",
        "tooltip": "Текстовое описание желаемого результата (макс. 2000 символов). Требуется хотя бы один из параметров: 'prompt' или 'reference_image'."
      },
      "reference_image": {
        "name": "референс-изображение",
        "tooltip": "Референс-изображение, внешний вид которого (фон, освещение, костюм) должен быть применён к результату. Требуется хотя бы один из параметров: 'reference_image' или 'prompt'."
      },
      "seed": {
        "name": "seed",
        "tooltip": "Seed управляет тем, нужно ли заново запускать node; результаты всегда недетерминированы, независимо от seed."
      }
    },
    "outputs": {
      "0": {
        "name": "изображение",
        "tooltip": null
      },
      "1": {
        "name": "alpha",
        "tooltip": "Альфа-маска, использованная Beeble. Пусто для режима 'fill', в котором отдельная маска не используется."
      }
    }
  },
  "BeebleSwitchXVideoEdit": {
    "description": "Редактируйте видео с помощью Beeble SwitchX. Меняет любые элементы сцены (фон, освещение, костюм), сохраняя исходные пиксели и движение объекта. Укажите референс-изображение и/или текстовый промпт для описания нового вида. Макс. 240 кадров, макс. ~2,77 МП на кадр.",
    "display_name": "Beeble SwitchX Редактирование видео",
    "inputs": {
      "alpha_mode": {
        "name": "alpha_mode",
        "tooltip": "Определяет, как SwitchX решает, что сохранить, а что сгенерировать заново. 'auto' автоматически изолирует основной объект. 'fill' регенерирует весь кадр, сохраняя геометрию. 'select' распространяет ключевой кадр первого кадра по всему clip. 'custom' использует предоставленную вами альфа-маску для каждого кадра."
      },
      "control_after_generate": {
        "name": "контроль после генерации"
      },
      "max_resolution": {
        "name": "максимальное разрешение",
        "tooltip": "Максимальное разрешение результата."
      },
      "prompt": {
        "name": "промпт",
        "tooltip": "Текстовое описание желаемого результата (макс. 2000 символов). Требуется хотя бы один из параметров: 'prompt' или 'reference_image'."
      },
      "reference_image": {
        "name": "референс-изображение",
        "tooltip": "Референс-изображение, внешний вид которого (фон, освещение, костюм) должен быть применён к результату. Требуется хотя бы один из параметров: 'reference_image' или 'prompt'."
      },
      "seed": {
        "name": "seed",
        "tooltip": "Seed управляет тем, нужно ли заново запускать node; результаты всегда недетерминированы, независимо от seed."
      },
      "video": {
        "name": "видео"
      }
    },
    "outputs": {
      "0": {
        "name": "видео",
        "tooltip": null
      },
      "1": {
        "name": "alpha",
        "tooltip": "Альфа-маска, использованная Beeble. Пусто для режима 'fill', в котором отдельная маска не используется."
      }
    }
  },
  "BerniniConditioning": {
    "description": "Узел кондиционирования для Bernini для контекстного кондиционирования видео/изображений. Может использоваться для следующих задач: t2v (текст-видео), v2v (видео-видео), rv2v (редактирование видео с помощью референса), r2v (референс-видео), ads2v (вставка изображения/видео в видео). Референсные изображения, внедрённые как контекстные токены (r2v, rv2v), кодируются независимо с их собственным исходным соотношением сторон (длинная сторона ограничена ref_max_size).",
    "display_name": "Bernini Conditioning",
    "inputs": {
      "batch_size": {
        "name": "batch_size"
      },
      "height": {
        "name": "height"
      },
      "length": {
        "name": "length"
      },
      "negative": {
        "name": "negative"
      },
      "positive": {
        "name": "positive"
      },
      "ref_max_size": {
        "name": "ref_max_size",
        "tooltip": "Максимальный размер длинной стороны для reference_video и reference_images. Изменяется с сохранением пропорций и округляется до 16 пикселей."
      },
      "reference_images": {
        "name": "reference_images"
      },
      "reference_video": {
        "name": "reference_video",
        "tooltip": "Видео для вставки в исходное видео (ads2v)."
      },
      "source_video": {
        "name": "source_video",
        "tooltip": "Исходное видео для редактирования или изменения стиля (v2v, rv2v). Изменяется до ширины/высоты и обрезается до длины."
      },
      "vae": {
        "name": "vae"
      },
      "width": {
        "name": "width"
      }
    },
    "outputs": {
      "0": {
        "name": "positive",
        "tooltip": null
      },
      "1": {
        "name": "negative",
        "tooltip": null
      },
      "2": {
        "name": "latent",
        "tooltip": null
      }
    }
  },
