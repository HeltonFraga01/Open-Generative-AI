  "SplatToMesh": {
    "description": "Извлечь цветную mesh из гауссового splat.",
    "display_name": "Извлечь Mesh из Splat",
    "inputs": {
      "color_sharpen": {
        "name": "резкость_цвета",
        "tooltip": "Улучшить чёткость текстуры вершин: 1.0 = физически корректное смешивание; выше смещает цвет каждого вокселя к доминирующему гауссиану вместо усреднения с соседями (убирает размытие текстуры). Только цвет — геометрия не меняется."
      },
      "kernel": {
        "name": "ядро",
        "tooltip": "Максимальная полу-ширина splat в вокселях. Каждый гауссиан растеризуется в окне, размер которого равен его собственным 3-сигма, ограниченным этим значением — маленькие surfel остаются дешёвыми, большие не обрезаются. Увеличьте, если разреженные splat оставляют пробелы."
      },
      "level": {
        "name": "уровень",
        "tooltip": "Уровень изо-поверхности. Автоматически выбирается методом Отсу; это смещает его (1.0 = авто, ниже = более толстая/связанная поверхность, выше = более тонкая/плотная)."
      },
      "min_component": {
        "name": "мин_компонент",
        "tooltip": "Удалять связанные компоненты меньше этого количества вершин (0 = оставить все). Удаляет отдельные плавающие фрагменты и внутреннюю оболочку двойной стены."
      },
      "min_opacity": {
        "name": "мин_непрозрачность",
        "tooltip": "Игнорировать гауссианы слабее этого значения перед построением mesh."
      },
      "resolution": {
        "name": "разрешение",
        "tooltip": "Разрешение плотностной сетки вдоль самой длинной оси. Выше = более детализированная поверхность, больше VRAM/времени (растёт как resolution^3)."
      },
      "smooth": {
        "name": "сглаживание",
        "tooltip": "Итерации сглаживания mesh по Таубину. Сглаживает поверхность без её уменьшения (с сохранением объёма), в отличие от размытия плотности. 0 = необработанная поверхность."
      },
      "splat": {
        "name": "splat"
      }
    },
    "outputs": {
      "0": {
        "name": "mesh",
        "tooltip": null
      }
    }
  },
