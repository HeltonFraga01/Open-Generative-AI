  "SplatToMesh": {
    "description": "Extrai uma malha colorida de um gaussian splat.",
    "display_name": "Extrair Malha do Splat",
    "inputs": {
      "color_sharpen": {
        "name": "nitidez_cor",
        "tooltip": "Deixa a textura dos vértices mais nítida: 1.0 = mistura fisicamente correta; valores maiores tendem a cor de cada voxel para sua gaussiana dominante ao invés de fazer média com vizinhos (reduz borrão da textura). Apenas cor - geometria não é alterada."
      },
      "kernel": {
        "name": "kernel",
        "tooltip": "Largura máxima do splat em voxels (meia-largura). Cada gaussiana é rasterizada em uma janela do seu próprio 3-sigma, limitada aqui - surfels pequenos permanecem leves, grandes não são truncados. Aumente se splats esparsos deixarem lacunas."
      },
      "level": {
        "name": "nível",
        "tooltip": "Nível da iso-superfície. Escolhido automaticamente por Otsu; este valor o ajusta (1.0 = auto, menor = superfície mais grossa/conectada, maior = mais fina/justa)."
      },
      "min_component": {
        "name": "mín_componente",
        "tooltip": "Descarta componentes conectados menores que este número de vértices (0 = mantém todos). Remove blobs flutuantes desconectados e a camada interna da parede dupla."
      },
      "min_opacity": {
        "name": "mín_opacidade",
        "tooltip": "Ignora gaussianas mais fracas que este valor antes de gerar a malha."
      },
      "resolution": {
        "name": "resolução",
        "tooltip": "Resolução da grade de densidade ao longo do eixo mais longo. Maior = superfície mais fina, mais VRAM/tempo (cresce com resolução^3)."
      },
      "smooth": {
        "name": "suavizar",
        "tooltip": "Iterações de suavização de malha Taubin. Suaviza a superfície sem encolhê-la (preserva o volume), diferente do desfoque da densidade. 0 = superfície bruta."
      },
      "splat": {
        "name": "splat"
      }
    },
    "outputs": {
      "0": {
        "name": "malha",
        "tooltip": null
      }
    }
  },
