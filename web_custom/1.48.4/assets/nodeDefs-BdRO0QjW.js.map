      },
      "prompt": {
        "name": "prompt",
        "tooltip": "Descreve o que deve aparecer na saída (1-1000 caracteres)."
      },
      "prompt_images": {
        "name": "imagens de prompt",
        "tooltip": "Imagens de orientação ancoradas ao vídeo de saída, de nós Aleph2 Prompt Image (até 5). Use quadros-chave ou imagens de prompt, não ambos."
