  "BeebleSwitchXImageEdit": {
    "description": "Edite uma única imagem com Beeble SwitchX. Altere qualquer elemento da cena (fundo, iluminação, figurino) enquanto preserva os pixels originais do sujeito. Forneça uma imagem de referência e/ou um prompt de texto para descrever o novo visual. Máx. ~2,77MP.",
    "display_name": "Beeble SwitchX Edição de Imagem",
    "inputs": {
      "alpha_mode": {
        "name": "alpha_mode",
        "tooltip": "Controla como o SwitchX decide o que manter ou regenerar. 'auto' isola automaticamente o sujeito principal. 'fill' regenera todo o quadro preservando a geometria. 'select' propaga um keyframe do primeiro quadro ao longo do clip. 'custom' utiliza um alpha matte por quadro fornecido por você."
      },
      "control_after_generate": {
        "name": "controlar após gerar"
      },
      "image": {
        "name": "imagem"
      },
      "max_resolution": {
        "name": "resolução_máxima",
        "tooltip": "Resolução máxima de saída."
      },
      "prompt": {
        "name": "prompt",
        "tooltip": "Descrição em texto do resultado desejado (máx. 2000 caracteres). Pelo menos um dos campos 'prompt' ou 'reference_image' é obrigatório."
      },
      "reference_image": {
        "name": "imagem_de_referência",
        "tooltip": "Imagem de referência cujo visual (fundo, iluminação, figurino) o resultado deve adotar. Pelo menos um dos campos 'reference_image' ou 'prompt' é obrigatório."
      },
      "seed": {
        "name": "seed",
        "tooltip": "Seed controla se o nó deve ser executado novamente; os resultados são não determinísticos independentemente do seed."
      }
    },
    "outputs": {
      "0": {
        "name": "imagem",
        "tooltip": null
      },
      "1": {
        "name": "alpha",
        "tooltip": "O alpha matte utilizado pelo Beeble. Vazio no modo 'fill', que não possui matte separado."
      }
    }
  },
  "BeebleSwitchXVideoEdit": {
    "description": "Edite um vídeo com Beeble SwitchX. Altere qualquer elemento da cena (fundo, iluminação, figurino) enquanto preserva os pixels e o movimento originais do sujeito. Forneça uma imagem de referência e/ou um prompt de texto para descrever o novo visual. Máx. 240 quadros, máx. ~2,77MP por quadro.",
    "display_name": "Beeble SwitchX Edição de Vídeo",
    "inputs": {
      "alpha_mode": {
        "name": "alpha_mode",
        "tooltip": "Controla como o SwitchX decide o que manter ou regenerar. 'auto' isola automaticamente o sujeito principal. 'fill' regenera todo o quadro preservando a geometria. 'select' propaga um keyframe do primeiro quadro ao longo do clip. 'custom' utiliza um alpha matte por quadro fornecido por você."
      },
      "control_after_generate": {
        "name": "controlar após gerar"
      },
      "max_resolution": {
        "name": "resolução_máxima",
        "tooltip": "Resolução máxima de saída."
      },
      "prompt": {
        "name": "prompt",
        "tooltip": "Descrição em texto do resultado desejado (máx. 2000 caracteres). Pelo menos um dos campos 'prompt' ou 'reference_image' é obrigatório."
      },
      "reference_image": {
        "name": "imagem_de_referência",
        "tooltip": "Imagem de referência cujo visual (fundo, iluminação, figurino) o resultado deve adotar. Pelo menos um dos campos 'reference_image' ou 'prompt' é obrigatório."
      },
      "seed": {
        "name": "seed",
        "tooltip": "Seed controla se o nó deve ser executado novamente; os resultados são não determinísticos independentemente do seed."
      },
      "video": {
        "name": "vídeo"
      }
    },
    "outputs": {
      "0": {
        "name": "vídeo",
        "tooltip": null
      },
      "1": {
        "name": "alpha",
        "tooltip": "O alpha matte utilizado pelo Beeble. Vazio no modo 'fill', que não possui matte separado."
      }
    }
  },
  "BerniniConditioning": {
    "description": "Nó de condicionamento para Bernini em condicionamento de vídeo/imagem em contexto. Pode ser usado para as seguintes tarefas: t2v (texto para vídeo), v2v (vídeo para vídeo), rv2v (edição de vídeo guiada por referência), r2v (referência para vídeo), ads2v (inserir imagem/vídeo em vídeo). Imagens de referência injetadas como tokens em contexto (r2v, rv2v) são codificadas independentemente em sua própria proporção nativa (borda longa limitada por ref_max_size)",
    "display_name": "Bernini Conditioning",
    "inputs": {
      "batch_size": {
        "name": "tamanho_do_lote"
      },
      "height": {
        "name": "altura"
      },
      "length": {
        "name": "duração"
      },
      "negative": {
        "name": "negativo"
      },
      "positive": {
        "name": "positivo"
      },
      "ref_max_size": {
        "name": "ref_max_size",
        "tooltip": "Tamanho máximo para a borda longa de reference_video e reference_images. Redimensionado mantendo a proporção e ajustado para múltiplos de 16px."
      },
      "reference_images": {
        "name": "imagens_referência"
      },
      "reference_video": {
        "name": "vídeo_referência",
        "tooltip": "Vídeo a ser inserido no vídeo fonte (ads2v)."
      },
      "source_video": {
        "name": "vídeo_fonte",
        "tooltip": "Vídeo fonte para editar ou estilizar (v2v, rv2v). Redimensionado para largura/altura e cortado para a duração."
      },
      "vae": {
        "name": "vae"
      },
      "width": {
        "name": "largura"
      }
    },
    "outputs": {
      "0": {
        "name": "positivo",
        "tooltip": null
      },
      "1": {
        "name": "negativo",
        "tooltip": null
      },
      "2": {
        "name": "latent",
        "tooltip": null
      }
    }
  },
