  "RenderSplat": {
    "description": "Renderize um gaussian splat como uma imagem com um rasterizador EWA anisotrópico (splats elípticos orientados, antialiasing, ordenados por profundidade do mais próximo para o mais distante). A câmera vem de uma entrada camera_info (Load / Preview 3D, ou um nó Create Camera Info); deixe vazio para enquadrar automaticamente o splat. Defina frames maior que 1 para um lote de imagens em turntable para alimentar um nó Video.",
    "display_name": "Render Splat",
    "inputs": {
      "background": {
        "name": "fundo"
      },
      "bg_image": {
        "name": "imagem_fundo",
        "tooltip": "Imagem de fundo opcional composta atrás do splat (substitui a cor sólida de fundo). Redimensionada para o tamanho do render; um lote é usado por frame, uma única imagem para todos. Apenas para color/clay."
      },
      "camera_info": {
        "name": "camera_info",
        "tooltip": "Câmera para renderizar - uma câmera Load3D / Preview3D ou um nó Create Camera Info. Se vazio, o splat é enquadrado automaticamente de uma visão padrão 3/4."
      },
      "frames": {
        "name": "frames",
        "tooltip": "-1, 0, 1 = imagem única; >1 = turntable, a câmera orbita em 360 graus completos (funciona com qualquer camera_info). Valor negativo orbita no sentido oposto."
      },
      "headlight_shading": {
        "name": "sombreamento_headlight",
        "tooltip": "Sombreamento difuso de uma luz na câmera (headlight), usando as normais dos surfels do splat: escurece superfícies que se afastam da visão para revelar forma/curvatura. 0 = albedo plano, 1 = sombreamento mais forte."
      },
      "height": {
        "name": "altura"
      },
      "opacity_threshold": {
        "name": "limite_opacidade",
        "tooltip": "Remove gaussians com opacidade abaixo deste valor (remove flutuantes fracos)."
      },
      "render_style": {
        "name": "estilo_render",
        "tooltip": "O que a imagem de saída mostra: color (cor), clay (sombreamento neutro), depth (próximo=claro), normal (mapa de normais OpenGL)."
      },
      "sharpen": {
        "name": "nitidez",
        "tooltip": "Aumenta a nitidez dos splats sobrepostos: 1.0 = mistura fisicamente correta; valores maiores tendem cada pixel ao splat dominante (mais próximo) para textura mais nítida, sem encolher splats ou abrir lacunas. Não físico acima de 1."
      },
      "splat": {
        "name": "splat"
      },
      "splat_scale": {
        "name": "escala_splat",
        "tooltip": "Multiplicador na projeção de cada splat (menor = pontos mais nítidos, maior = superfície mais suave/preenchida)."
      },
      "width": {
        "name": "largura"
      }
    },
    "outputs": {
      "0": {
        "name": "imagem",
        "tooltip": null
      },
      "1": {
        "name": "mask",
        "tooltip": null
      }
    }
