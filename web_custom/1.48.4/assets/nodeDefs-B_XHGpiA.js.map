      },
      "max_resolution": {
        "name": "最大分辨率",
        "tooltip": "输出的最大分辨率。"
      },
      "prompt": {
        "name": "提示词",
        "tooltip": "期望输出的文本描述（最多 2000 字符）。“提示词”或“参考图像”至少需填写一项。"
      },
      "reference_image": {
        "name": "参考图像",
        "tooltip": "结果将采用该参考图像的外观（背景、光照、服装）。“参考图像”或“提示词”至少需填写一项。"
      },
      "seed": {
        "name": "种子",
        "tooltip": "种子控制节点是否重新运行；无论种子如何，结果都是非确定性的。"
      },
      "video": {
        "name": "视频"
      }
