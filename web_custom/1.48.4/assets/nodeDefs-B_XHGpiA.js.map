  "BerniniConditioning": {
    "description": "用于Bernini上下文视频/图像条件的条件节点。可用于以下任务：t2v（文本转视频）、v2v（视频转视频）、rv2v（参考引导视频编辑）、r2v（参考转视频）、ads2v（将图像/视频插入视频）。作为上下文token注入的参考图像（r2v、rv2v）会以其原生宽高比独立编码（长边最大为ref_max_size）。",
    "display_name": "Bernini Conditioning",
    "inputs": {
      "batch_size": {
        "name": "批量大小"
      },
      "height": {
        "name": "高度"
      },
      "length": {
        "name": "长度"
      },
      "negative": {
        "name": "negative"
      },
      "positive": {
        "name": "positive"
      },
      "ref_max_size": {
        "name": "参考最大尺寸",
        "tooltip": "reference_video和reference_images长边的最大尺寸。调整尺寸时保持宽高比，并对齐到16像素。"
      },
      "reference_images": {
        "name": "参考图像"
      },
      "reference_video": {
        "name": "参考视频",
        "tooltip": "要插入到源视频中的视频（ads2v）。"
      },
      "source_video": {
        "name": "源视频",
        "tooltip": "要编辑或重绘风格的视频（v2v，rv2v）。会被调整为指定宽高并裁剪到指定长度。"
      },
      "vae": {
        "name": "vae"
      },
      "width": {
        "name": "宽度"
      }
    },
    "outputs": {
      "0": {
        "name": "positive",
        "tooltip": null
      },
      "1": {
        "name": "negative",
        "tooltip": null
      },
      "2": {
        "name": "latent",
        "tooltip": null
      }
    }
  },
