  "BeebleSwitchXImageEdit": {
    "description": "使用 Beeble SwitchX 编辑单张图像。可切换场景中的任何元素（背景、光照、服装），同时保留原始主体像素。请提供参考图像和/或文本提示来描述新外观。最大约 2.77MP。",
    "display_name": "Beeble SwitchX 图像编辑",
    "inputs": {
      "alpha_mode": {
        "name": "alpha_mode",
        "tooltip": "控制 SwitchX 如何决定保留或重生成内容。'auto' 自动隔离主要主体。'fill' 重生成整个画面并保留几何结构。'select' 将首帧关键帧传播到整个 clip。'custom' 使用您提供的每帧 alpha mask。"
      },
      "control_after_generate": {
        "name": "生成后控制"
      },
      "image": {
        "name": "图像"
      },
      "max_resolution": {
        "name": "最大分辨率",
        "tooltip": "输出的最大分辨率。"
      },
      "prompt": {
        "name": "提示词",
        "tooltip": "期望输出的文本描述（最多 2000 字符）。“提示词”或“参考图像”至少需填写一项。"
      },
      "reference_image": {
        "name": "参考图像",
        "tooltip": "结果将采用该参考图像的外观（背景、光照、服装）。“参考图像”或“提示词”至少需填写一项。"
      },
      "seed": {
        "name": "种子",
        "tooltip": "种子控制节点是否重新运行；无论种子如何，结果都是非确定性的。"
      }
    },
    "outputs": {
      "0": {
        "name": "图像",
        "tooltip": null
      },
      "1": {
        "name": "alpha",
        "tooltip": "Beeble 使用的 alpha mask。'fill' 模式下为空，该模式没有单独的 mask。"
      }
    }
  },
  "BeebleSwitchXVideoEdit": {
    "description": "使用 Beeble SwitchX 编辑视频。可切换场景中的任何元素（背景、光照、服装），同时保留原始主体像素和动作。请提供参考图像和/或文本提示来描述新外观。最多 240 帧，每帧最大约 2.77MP。",
