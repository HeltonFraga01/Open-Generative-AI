      "negative": {
        "name": "negative"
      },
      "positive": {
        "name": "positive"
      },
      "ref_max_size": {
        "name": "參考最大尺寸",
        "tooltip": "reference_video 與 reference_images 長邊的最大尺寸。會保持長寬比縮放並對齊至 16px。"
      },
      "reference_images": {
        "name": "參考圖像"
      },
      "reference_video": {
        "name": "參考影片",
        "tooltip": "要插入來源影片的影片（ads2v）。"
      },
      "source_video": {
        "name": "來源影片",
        "tooltip": "要編輯或重製風格的來源影片（v2v、rv2v）。會調整為指定寬高並裁剪至指定長度。"
      },
      "vae": {
        "name": "vae"
      },
      "width": {
        "name": "寬度"
      }
    },
    "outputs": {
      "0": {
        "name": "positive",
        "tooltip": null
      },
      "1": {
        "name": "negative",
        "tooltip": null
      },
      "2": {
        "name": "latent",
        "tooltip": null
      }
    }
