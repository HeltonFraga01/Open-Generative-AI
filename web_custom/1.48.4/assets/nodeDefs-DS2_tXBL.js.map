  "BeebleSwitchXImageEdit": {
    "description": "ערוך תמונה בודדת עם Beeble SwitchX. מחליף כל דבר בסצנה (רקע, תאורה, תלבושת) תוך שמירה על הפיקסלים המקוריים של הנושא. יש לספק תמונת ייחוס ו/או פרומפט טקסטואלי לתיאור המראה החדש. מקסימום ~2.77MP.",
    "display_name": "עריכת תמונה Beeble SwitchX",
    "inputs": {
      "alpha_mode": {
        "name": "מצב אלפא",
        "tooltip": "שולט כיצד SwitchX מחליט מה לשמור ומה ליצור מחדש. 'auto' מזהה אוטומטית את הנושא הראשי. 'fill' יוצר מחדש את כל הפריים תוך שמירה על הגיאומטריה. 'select' מפיץ keyframe מהפריים הראשון לאורך ה-clip. 'custom' משתמש במאט אלפא פר פריים שאתה מספק."
      },
      "control_after_generate": {
        "name": "שליטה לאחר יצירה"
      },
      "image": {
        "name": "תמונה"
      },
      "max_resolution": {
        "name": "רזולוציה מרבית",
        "tooltip": "הרזולוציה המרבית של הפלט."
      },
      "prompt": {
        "name": "פרומפט",
        "tooltip": "תיאור טקסטואלי של התוצאה הרצויה (עד 2000 תווים). לפחות אחד מהשדות 'prompt' או 'reference_image' נדרש."
      },
      "reference_image": {
        "name": "תמונת ייחוס",
        "tooltip": "תמונת ייחוס שממנה יאומץ המראה (רקע, תאורה, תלבושת) של התוצאה. לפחות אחד מהשדות 'reference_image' או 'prompt' נדרש."
      },
      "seed": {
        "name": "seed",
        "tooltip": "ה-seed שולט האם הצומת ירוץ מחדש; התוצאות אינן דטרמיניסטיות ללא קשר ל-seed."
      }
    },
    "outputs": {
      "0": {
        "name": "תמונה",
        "tooltip": null
      },
      "1": {
        "name": "אלפא",
        "tooltip": "מאט האלפא בו השתמש Beeble. ריק במצב 'fill', בו אין מאט נפרד."
      }
    }
  },
  "BeebleSwitchXVideoEdit": {
    "description": "עריכת וידאו עם Beeble SwitchX. מחליף כל דבר בסצנה (רקע, תאורה, תלבושת) תוך שמירה על הפיקסלים והתנועה המקוריים של הנושא. יש לספק תמונת ייחוס ו/או פרומפט טקסטואלי לתיאור המראה החדש. עד 240 פריימים, עד ~2.77MP לכל פריים.",
    "display_name": "Beeble SwitchX Video Edit",
    "inputs": {
      "alpha_mode": {
        "name": "מצב אלפא",
        "tooltip": "שולט כיצד SwitchX מחליט מה לשמור ומה ליצור מחדש. 'auto' מזהה אוטומטית את הנושא הראשי. 'fill' יוצר מחדש את כל הפריים תוך שמירה על הגיאומטריה. 'select' מפיץ keyframe מהפריים הראשון לאורך הקליפ. 'custom' משתמש במאט אלפא לכל פריים שתספק."
      },
      "control_after_generate": {
        "name": "שליטה לאחר יצירה"
      },
      "max_resolution": {
        "name": "רזולוציה מרבית",
        "tooltip": "הרזולוציה המרבית של הפלט."
      },
      "prompt": {
        "name": "פרומפט",
        "tooltip": "תיאור טקסטואלי של התוצאה הרצויה (עד 2000 תווים). נדרש לפחות אחד מהשדות 'prompt' או 'reference_image'."
      },
      "reference_image": {
        "name": "תמונת ייחוס",
        "tooltip": "תמונת ייחוס שהמראה שלה (רקע, תאורה, תלבושת) ישמש בתוצאה. נדרש לפחות אחד מהשדות 'reference_image' או 'prompt'."
      },
      "seed": {
        "name": "seed",
        "tooltip": "Seed שולט האם הצומת ירוץ מחדש; התוצאות אינן דטרמיניסטיות ללא קשר ל-seed."
      },
      "video": {
        "name": "וידאו"
      }
    },
    "outputs": {
      "0": {
        "name": "וידאו",
        "tooltip": null
      },
      "1": {
        "name": "אלפא",
        "tooltip": "מאט האלפא שבו השתמש Beeble. ריק במצב 'fill', שבו אין מאט נפרד."
      }
    }
  },
  "BerniniConditioning": {
    "description": "צומת קונדישנינג עבור Bernini לקונדישנינג של וידאו/תמונה בהקשר. ניתן להשתמש בו למשימות הבאות: t2v (טקסט לוידאו), v2v (וידאו לוידאו), rv2v (עריכת וידאו מונחית ייחוס), r2v (ייחוס לוידאו), ads2v (הוספת תמונה/וידאו לוידאו). תמונות ייחוס המוזרקות כטוקנים בהקשר (r2v, rv2v) מקודדות באופן עצמאי בפרופורציות המקוריות שלהן (הצד הארוך מוגבל ל-ref_max_size).",
    "display_name": "Bernini Conditioning",
    "inputs": {
      "batch_size": {
        "name": "גודל אצווה"
      },
      "height": {
        "name": "גובה"
      },
      "length": {
        "name": "אורך"
      },
      "negative": {
        "name": "שלילי"
      },
      "positive": {
        "name": "חיובי"
      },
      "ref_max_size": {
        "name": "ref_max_size",
        "tooltip": "הגודל המרבי של הצד הארוך של reference_video ו-reference_images. משנה גודל תוך שמירה על יחס גובה-רוחב ומעוגל ל-16 פיקסלים."
      },
      "reference_images": {
        "name": "תמונות ייחוס"
      },
      "reference_video": {
        "name": "וידאו ייחוס",
        "tooltip": "וידאו להוספה לוידאו המקור (ads2v)."
      },
      "source_video": {
        "name": "וידאו מקור",
